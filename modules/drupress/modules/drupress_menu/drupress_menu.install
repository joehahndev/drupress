<?php

/**
 * @file
 * Install and uninstall hooks for Drupress Menu.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 *
 * Ensures the Drupress admin menu exists, then swaps it into core
 * Navigation's sidebar layout.
 *
 * The menu is normally provided by config/install/system.menu.drupress-admin
 * .yml, but when this module is installed as part of a batch (notably: a
 * Drupal recipe installing many modules together), that default-config import
 * does not reliably complete before hook_install() runs, leaving the
 * "navigation_menu:drupress-admin" block with no menu to derive from. Create
 * the menu programmatically here as a defensive, idempotent fallback, with
 * the same enforced module dependency the YAML declares, so it is still
 * cleaned up automatically on uninstall.
 *
 * Swapping the Navigation block layout is the one documented case where
 * Drupress modifies configuration it does not own (navigation.block_layout).
 * The previous layout is backed up to state and restored on uninstall,
 * keeping the change fully reversible.
 */
function drupress_menu_install(): void {
  $menu_storage = \Drupal::entityTypeManager()->getStorage('menu');
  if ($menu_storage->load('drupress-admin') === NULL) {
    $menu_storage->create([
      'id' => 'drupress-admin',
      'label' => 'Drupress admin',
      'description' => 'WordPress-style admin sidebar menu provided by Drupress.',
      'locked' => TRUE,
      'dependencies' => ['enforced' => ['module' => ['drupress_menu']]],
    ])->save();
  }

  $config = \Drupal::configFactory()->getEditable('navigation.block_layout');
  $sections = $config->get('sections');
  if (!is_array($sections) || !isset($sections[0]['components'])) {
    return;
  }

  \Drupal::state()->set('drupress_menu.navigation_layout_backup', $sections);

  // Replace the content-region blocks (shortcuts, content menu, admin menu)
  // with the single Drupress admin menu, WordPress-style. Footer blocks
  // (user, help) are kept.
  $components = array_filter(
    $sections[0]['components'],
    static fn (array $component): bool => ($component['region'] ?? '') !== 'content'
  );

  $uuid = \Drupal::service('uuid')->generate();
  $components[$uuid] = [
    'uuid' => $uuid,
    'region' => 'content',
    'configuration' => [
      'id' => 'navigation_menu:drupress-admin',
      'label' => 'Drupress admin',
      'label_display' => '0',
      'provider' => 'navigation',
      'level' => 1,
      'depth' => 2,
    ],
    'weight' => 0,
    'additional' => [],
  ];

  $sections[0]['components'] = $components;
  $config->set('sections', $sections)->save();
}

/**
 * Implements hook_uninstall().
 *
 * Restores the Navigation sidebar layout captured at install time.
 */
function drupress_menu_uninstall(): void {
  $state = \Drupal::state();
  $backup = $state->get('drupress_menu.navigation_layout_backup');
  if (is_array($backup)) {
    \Drupal::configFactory()->getEditable('navigation.block_layout')
      ->set('sections', $backup)
      ->save();
  }
  $state->delete('drupress_menu.navigation_layout_backup');
}
