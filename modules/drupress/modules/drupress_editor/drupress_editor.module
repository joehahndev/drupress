<?php

/**
 * @file
 * WordPress-style editor screen: Gutenberg sidebar integration.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\Form\NodeForm;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * Presents the WordPress-model fields (Featured image, Categories, Tags) as
 * collapsible panels in the Gutenberg editor's document sidebar — exactly
 * how WordPress lays out its post document panels.
 *
 * Mechanism: Gutenberg only relocates Drupal's "advanced" group (the vertical
 * tabs whose id is edit-advanced) into its React sidebar; that is why the core
 * Menu settings, URL alias, Authoring, etc. panels appear there. Anything left
 * in a plain top-level container stays in the hidden staging markup. So each
 * mapped field is wrapped in its own details element placed in the advanced
 * group, riding along into the visible sidebar with negative weights so the WP
 * panels sit above the core ones.
 */
function drupress_editor_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }
  $node = $form_object->getEntity();
  // Same check Gutenberg's own alter performs. Read the config directly:
  // this alter runs before Gutenberg's, and with lazy .module loading its
  // helper function may not be defined yet.
  if (!\Drupal::config('gutenberg.settings')->get($node->bundle() . '_enable_full')) {
    return;
  }
  // The advanced group is the vehicle into the sidebar; bail if it is absent.
  if (!isset($form['advanced'])) {
    return;
  }

  // Gutenberg ships admin-theme compatibility CSS keyed to Claro only;
  // drupress_admin is a Claro subtheme, so attach it here, along with the
  // WP-style panel CSS for the relocated sidebar fields.
  if (\Drupal::theme()->getActiveTheme()->getName() === 'drupress_admin') {
    $form['#attached']['library'][] = 'gutenberg/claro';
    $form['#attached']['library'][] = 'drupress_admin/editor';
  }

  // Fields are resolved through the mapping (never hard-coded names); anything
  // unresolved is simply skipped — graceful degradation, per the facade
  // principle. Featured image leads, matching WordPress' panel order.
  /** @var \Drupal\drupress\DrupressMapping $mapping */
  $mapping = \Drupal::service('drupress.mapping');
  $bundle = $node->bundle();

  $panels = [
    'drupress_featured_image' => [
      'title' => t('Featured image'),
      'field' => $bundle === $mapping->postType() ? $mapping->featuredImageField() : NULL,
      'weight' => -100,
    ],
    'drupress_categories' => [
      'title' => t('Categories'),
      'field' => $mapping->categoryField($bundle),
      'weight' => -99,
    ],
    'drupress_tags' => [
      'title' => t('Tags'),
      'field' => $mapping->tagField($bundle),
      'weight' => -98,
    ],
  ];

  foreach ($panels as $panel_id => $panel) {
    $field_name = $panel['field'];
    if ($field_name === NULL || !isset($form[$field_name])) {
      continue;
    }
    $form[$panel_id] = [
      '#type' => 'details',
      '#title' => $panel['title'],
      '#group' => 'advanced',
      '#weight' => $panel['weight'],
      '#open' => TRUE,
      '#attributes' => ['class' => ['drupress-sidebar-panel']],
    ];
    // Move the widget into the panel and hide its now-redundant field label
    // (the panel title already names it).
    $form[$panel_id][$field_name] = $form[$field_name];
    unset($form[$panel_id][$field_name]['#group']);
    if (isset($form[$panel_id][$field_name]['widget']['#title'])) {
      $form[$panel_id][$field_name]['widget']['#title_display'] = 'invisible';
    }
    unset($form[$field_name]);

    // Details-type widgets (e.g. the media library widget) are listed in
    // Gutenberg's '#fields_with_details'; its after-build would register them
    // with the metabox JS and move their DOM into the tray. Keep them out.
    if (!empty($form['#fields_with_details'])) {
      $form['#fields_with_details'] = array_values(array_diff($form['#fields_with_details'], [$field_name]));
    }
  }
}
