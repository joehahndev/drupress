# Run from inside the DDEV web container of the dev site (~/drupress-dev), with
# the site root as cwd so Drupal core is auto-discovered:
#   cd /var/www/html && /mnt/c/dev/drupress-drupal-module-suite/vendor/bin/phpstan \
#     analyse -c /mnt/c/dev/drupress-drupal-module-suite/phpstan.neon
# phpstan-drupal and the deprecation rules are auto-registered by
# phpstan/extension-installer (a require-dev of this repo), so they are not
# included manually here — doing both double-registers the Drupal ServiceMap.
parameters:
	level: 6
	paths:
		- /mnt/c/dev/drupress-drupal-module-suite/modules
		- /mnt/c/dev/drupress-drupal-module-suite/themes
	ignoreErrors:
		# Drupal hooks and Form API conventionally use untyped arrays.
		- identifier: missingType.iterableValue
